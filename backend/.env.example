DB_HOST=tu-host-mysql
DB_PORT=3306
DB_USER=tu-usuario
DB_PASSWORD=tu-password
DB_NAME=mi_condominio
# Ronda 36: si tu proveedor de MySQL soporta/exige TLS (recomendado en
# producción), poner en "true". Déjalo sin definir o en "false" para
# desarrollo local (MySQL/MariaDB sin certificado configurado).
DB_SSL=false
# Solo si DB_SSL=true y da error de certificado no reconocido (pasa con
# algunos proveedores que usan certificados propios) — por defecto valida el
# certificado (más seguro), poner en "false" para desactivar esa validación.
# DB_SSL_REJECT_UNAUTHORIZED=false
# Obligatoria — el backend no arranca sin esto (ver auth.service.ts).
# Generar con: openssl rand -base64 48
JWT_SECRET=genera-un-secreto-largo-y-aleatorio-aqui
PORT=3000
